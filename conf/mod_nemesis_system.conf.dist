#
# Nemesis System module configuration
#

[worldserver]

#
#    NemesisSystem.Enable
#        Description: Enables the Nemesis System module.
#        Default:     1 - enabled
#                     0 - disabled
#

NemesisSystem.Enable = 1

#
#    NemesisSystem.CitySiegeIntegration.Enable
#        Description: Allows active City Siege attackers and defenders to roll
#                     for nemesis promotion when they kill a real player.
#                     Siege-created nemeses are runtime-only because siege
#                     creatures are temporary summons.
#        Default:     0 - disabled
#                     1 - enabled
#

NemesisSystem.CitySiegeIntegration.Enable = 0

#
#    NemesisSystem.CitySiegeIntegration.Chance
#        Description: Percent chance for an active City Siege attacker or
#                     defender to trigger a nemesis promotion on a real-player
#                     kill when the integration is enabled.
#        Default:     10.0
#

NemesisSystem.CitySiegeIntegration.Chance = 10.0

#
#    NemesisSystem.MaxRank
#        Description: Maximum rank a nemesis can reach.
#        Default:     5
#

NemesisSystem.MaxRank = 5

#
#    NemesisSystem.MinCreatureLevel
#        Description: Minimum creature level eligible to become a nemesis.
#        Default:     1
#

NemesisSystem.MinCreatureLevel = 1

#
#    NemesisSystem.MaxCreatureLevel
#        Description: Maximum creature level eligible to become a nemesis.
#        Default:     255
#

NemesisSystem.MaxCreatureLevel = 255

#
#    NemesisSystem.AllowNormal
#        Description: Allow normal-rank creatures to become nemeses.
#        Default:     1 - enabled
#                     0 - disabled
#

NemesisSystem.AllowNormal = 1

#
#    NemesisSystem.AllowElite
#        Description: Allow elite-rank creatures to become nemeses.
#        Default:     1 - enabled
#                     0 - disabled
#

NemesisSystem.AllowElite = 1

#
#    NemesisSystem.AllowRare
#        Description: Allow rare-rank creatures to become nemeses.
#        Default:     1 - enabled
#                     0 - disabled
#

NemesisSystem.AllowRare = 1

#
#    NemesisSystem.AllowRareElite
#        Description: Allow rare-elite creatures to become nemeses.
#        Default:     1 - enabled
#                     0 - disabled
#

NemesisSystem.AllowRareElite = 1

#
#    NemesisSystem.AllowWorldBoss
#        Description: Allow world-boss rank creatures to become nemeses.
#                     Dungeon and scripted bosses are still filtered separately.
#        Default:     0 - disabled
#

NemesisSystem.AllowWorldBoss = 0

#
#    NemesisSystem.MaxPerZone
#        Description: Maximum number of active nemeses allowed per zone.
#                     New nemesis creation is blocked in a zone once this
#                     limit is reached (existing nemeses can still rank up).
#                     Set to 0 for unlimited.
#        Default:     20
#

NemesisSystem.MaxPerZone = 20

#
#    NemesisSystem.RankUpCooldownSeconds
#        Description: Minimum time in seconds before the same creature can gain
#                     another nemesis promotion.
#        Default:     300
#

NemesisSystem.RankUpCooldownSeconds = 900

#
#    NemesisSystem.SameVictimCooldownSeconds
#        Description: Minimum time in seconds before the same player can feed
#                     another promotion to the same creature.
#        Default:     900
#

NemesisSystem.SameVictimCooldownSeconds = 2700

#
#    NemesisSystem.PromotionLevelDiffMax
#        Description: Maximum absolute level difference allowed between the
#                     creature and the slain player for nemesis creation or
#                     rank-up.
#        Default:     5
#

NemesisSystem.PromotionLevelDiffMax = 5

#
#    NemesisSystem.TrivialKillLevelDelta
#        Description: Additional anti-trivial filter. If a creature is this
#                     many or more levels below the slain player, it cannot
#                     become or rank up as a nemesis.
#        Default:     5
#

NemesisSystem.TrivialKillLevelDelta = 5

#
#    NemesisSystem.DecayHours
#        Description: Deletes inactive nemesis state after this many hours.
#                     Set to 0 to disable decay.
#        Default:     48
#

NemesisSystem.DecayHours = 48

#
#    NemesisSystem.RevengeRewardItem
#        Description: Optional item reward granted when the original target or
#                     their party kills the nemesis.
#        Default:     0 - disabled
#

NemesisSystem.RevengeRewardItem = 0

#
#    NemesisSystem.RevengeRewardCount
#        Description: Count for the revenge reward item.
#        Default:     1
#

NemesisSystem.RevengeRewardCount = 1

#
#    NemesisSystem.RevengeRewardItemPerRankBonus
#        Description: Additional item count granted per rank above rank 1.
#        Default:     0
#

NemesisSystem.RevengeRewardItemPerRankBonus = 0

#
#    NemesisSystem.RevengeRewardGold
#        Description: Gold reward in copper for revenge kills.
#        Default:     10000
#

NemesisSystem.RevengeRewardGold = 1

#
#    NemesisSystem.RevengeRewardGoldPerRankBonus
#        Description: Additional copper granted per rank above rank 1.
#        Default:     2500
#

NemesisSystem.RevengeRewardGoldPerRankBonus = 1

#
#    NemesisSystem.BountyRewardItem
#        Description: Optional item reward granted when another player kills a
#                     nemesis that targets someone else.
#        Default:     0 - disabled
#

NemesisSystem.BountyRewardItem = 0

#
#    NemesisSystem.BountyRewardCount
#        Description: Count for the bounty reward item.
#        Default:     1
#

NemesisSystem.BountyRewardCount = 1

#
#    NemesisSystem.BountyRewardItemPerRankBonus
#        Description: Additional item count granted per rank above rank 1.
#        Default:     0
#

NemesisSystem.BountyRewardItemPerRankBonus = 0

#
#    NemesisSystem.BountyRewardGold
#        Description: Gold reward in copper for bounty kills.
#        Default:     2500
#

NemesisSystem.BountyRewardGold = 1

#
#    NemesisSystem.BountyRewardGoldPerRankBonus
#        Description: Additional copper granted per rank above rank 1.
#        Default:     500
#

NemesisSystem.BountyRewardGoldPerRankBonus = 1

#
#    NemesisSystem.RewardOverlevelDiffMax
#        Description: Maximum positive level difference between the highest
#                     eligible nearby reward recipient and the nemesis before
#                     rewards scale down to zero.
#        Default:     10
#

NemesisSystem.RewardOverlevelDiffMax = 10

#
#    NemesisSystem.RewardUnderlevelDiffMax
#        Description: Maximum negative level difference used to scale rewards
#                     upward when the highest eligible nearby reward recipient
#                     is below the nemesis level.
#        Default:     10
#

NemesisSystem.RewardUnderlevelDiffMax = 10

#
#    NemesisSystem.RewardUnderdogMaxMultiplier
#        Description: Maximum reward multiplier reached when the highest
#                     eligible nearby reward recipient is at least
#                     RewardUnderlevelDiffMax levels below the nemesis.
#        Default:     2.0
#

NemesisSystem.RewardUnderdogMaxMultiplier = 2.0

#
#    NemesisSystem.EnragedHealthPctThreshold
#        Description: Health percentage at or below which the Enraged affix becomes active.
#        Default:     30.0
#

NemesisSystem.EnragedHealthPctThreshold = 30.0

#
#    NemesisSystem.EnragedDamageMultiplier
#        Description: Damage multiplier applied while the Enraged affix is active.
#        Default:     1.50
#

NemesisSystem.EnragedDamageMultiplier = 1.50

#
#    NemesisSystem.RegenerationIntervalMs
#        Description: Tick interval in milliseconds for the Regenerating affix.
#        Default:     5000
#

NemesisSystem.RegenerationIntervalMs = 5000

#
#    NemesisSystem.RegenerationHealthPct
#        Description: Percent of max health restored each regeneration tick.
#        Default:     3.0
#

NemesisSystem.RegenerationHealthPct = 3.0

#
#    NemesisSystem.AnnounceOnCreate
#        Description: Sends nemesis creation and rank-up announcements to the
#                     nemesis zone. Reaching rank 5 is announced server-wide.
#        Default:     1 - enabled
#                     0 - disabled
#

NemesisSystem.AnnounceOnCreate = 1

#
#    NemesisSystem.AnnounceOnKill
#        Description: Sends nemesis kill announcements to the nemesis zone.
#        Default:     1 - enabled
#                     0 - disabled
#

NemesisSystem.AnnounceOnKill = 1

#
#    NemesisSystem.AnnounceMinRank
#        Description: Minimum nemesis rank required before announcements are sent.
#        Default:     1
#

NemesisSystem.AnnounceMinRank = 1

#
#    NemesisSystem.VisualAuraSpell
#        Description: Optional aura spell applied to active nemeses.
#                     Set to 0 to disable the visual aura.
#        Default:     0
#

NemesisSystem.VisualAuraSpell = 0

#
#    NemesisSystem.AddonBootstrapRecentHours
#        Description: Recent nemeses within this many hours are included in
#                     player addon bootstrap responses, alongside rank 5 and
#                     relation-matched nemeses.
#        Default:     24
#

NemesisSystem.AddonBootstrapRecentHours = 24

#
#    NemesisSystem.AddonBootstrapMaxEntries
#        Description: Maximum number of nemesis entries sent in a filtered
#                     player addon bootstrap response.
#        Default:     100
#

NemesisSystem.AddonBootstrapMaxEntries = 100

#
#    NemesisSystem.AddonReportCooldownSeconds
#        Description: Minimum time between validated addon sighting updates for
#                     the same nemesis spawn.
#        Default:     30
#

NemesisSystem.AddonReportCooldownSeconds = 30

########################################
# BOUNTY VENDOR
########################################

#
#    NemesisSystem.BountyVendor.Enable
#        Description: Adds a "Bounty Hunter Rewards" gossip option to all
#                     innkeepers, opening a vendor window where players can
#                     spend Nemesis Bounty Tokens.
#        Default:     1 - Enabled
#                     0 - Disabled
#

NemesisSystem.BountyVendor.Enable = 1

#
#    NemesisSystem.BountyVendor.Entry
#        Description: The npc_vendor entry used for the LEGACY flat bounty
#                     vendor inventory (used only when RankMenus is disabled).
#                     All innkeepers share this vendor entry.
#        Default:     190000
#

NemesisSystem.BountyVendor.Entry = 190000

#
#    NemesisSystem.BountyVendor.RankMenus.Enable
#        Description: Replace the flat vendor with rank-gated gossip submenus:
#                     "Общие товары" (rank 1), "Печати и нашивки" (StatBooster,
#                     rank 2), "Сумки с фамильярами" (familiar gacha, rank 3).
#                     Locked submenus stay visible with a rank-requirement note.
#        Default:     1 - Enabled
#                     0 - Disabled (legacy flat vendor via .Entry)
#

NemesisSystem.BountyVendor.RankMenus.Enable = 1

#
#    NemesisSystem.BountyVendor.GeneralEntry
#        Description: npc_vendor entry for the "Общие товары" submenu (rank 1+):
#                     universal gacha bag, Attribute Recalibrator, T1 consumables.
#        Default:     190100
#

NemesisSystem.BountyVendor.GeneralEntry = 190100

#
#    NemesisSystem.BountyVendor.StatBoosterEntry
#        Description: npc_vendor entry for the "Печати и нашивки" submenu:
#                     all StatBooster consumables (T1-T4).
#        Default:     190101
#

NemesisSystem.BountyVendor.StatBoosterEntry = 190101

#
#    NemesisSystem.BountyVendor.FamiliarEntry
#        Description: npc_vendor entry for the "Сумки с фамильярами" submenu:
#                     the 10 element gacha bags (5 adventurer coins each).
#        Default:     190102
#

NemesisSystem.BountyVendor.FamiliarEntry = 190102

#
#    NemesisSystem.BountyVendor.StatBoosterRank
#        Description: Minimum Hunter's Covenant reputation rank (1-5) required
#                     to open the StatBooster submenu.
#        Default:     2 (Охотник)
#

NemesisSystem.BountyVendor.StatBoosterRank = 2

#
#    NemesisSystem.BountyVendor.FamiliarRank
#        Description: Minimum Hunter's Covenant reputation rank (1-5) required
#                     to open the familiar bags submenu.
#        Default:     3 (Следопыт)
#

NemesisSystem.BountyVendor.FamiliarRank = 3

########################################
# AMBIENT NEMESIS GENERATION
########################################

#
#    NemesisSystem.AmbientGeneration.Enable
#        Description: Periodically promote a random eligible mob to nemesis in
#                     open-world zones occupied by players, while the zone has
#                     fewer nemeses than FillPercent of MaxPerZone.
#                     One birth per zone per tick. Births have no victim
#                     (nemesis_target_guid = 0).
#        Default:     1 - Enabled
#

NemesisSystem.AmbientGeneration.Enable = 1

#
#    NemesisSystem.AmbientGeneration.IntervalMinSeconds
#    NemesisSystem.AmbientGeneration.IntervalMaxSeconds
#        Description: Each generation pass is followed by a RANDOM pause of
#                     [Min, Max] seconds, so births don't land on a fixed
#                     rhythm. Min is clamped to >= 30, Max to >= Min.
#        Default:     300 / 600 (5-10 minutes)
#

NemesisSystem.AmbientGeneration.IntervalMinSeconds = 300
NemesisSystem.AmbientGeneration.IntervalMaxSeconds = 600

#
#    NemesisSystem.AmbientGeneration.FillPercent
#        Description: Target fill level as a percent of NemesisSystem.MaxPerZone.
#                     A zone below this share of the cap gets one ambient birth
#                     per tick. Requires a finite MaxPerZone (0 disables ambient).
#        Default:     50
#

NemesisSystem.AmbientGeneration.FillPercent = 50

#
#    NemesisSystem.AmbientGeneration.EliteChance
#        Description: Percent chance (0-100) an ambient birth prefers an
#                     ELITE candidate when one exists in the zone — keeps
#                     continent-hunt (elite) targets present in the world.
#        Default:     25
#

NemesisSystem.AmbientGeneration.EliteChance = 25

#
#    NemesisSystem.AmbientGeneration.RankUpChance
#        Description: Percent chance (0-100) that a zone's ambient action
#                     RANKS UP an existing live nemesis of that zone instead
#                     of creating a new one. Honors the regular rank-up
#                     cooldown; falls back to a birth when no candidate.
#        Default:     10
#

NemesisSystem.AmbientGeneration.RankUpChance = 10

#
#    NemesisSystem.AmbientGeneration.RequireRealPlayers
#        Description: Only consider zones holding at least one REAL player
#                     (playerbots do not count). With 0, bot-populated zones
#                     also breed nemeses — the whole world fills up.
#        Default:     1
#

NemesisSystem.AmbientGeneration.RequireRealPlayers = 1

#
#    NemesisSystem.AmbientGeneration.Announce
#        Description: Announce ambient births with creature-type flavor text
#                     ("...вкусил(а) крови и обрёл(а) силу немезиды!").
#        Default:     1
#

NemesisSystem.AmbientGeneration.Announce = 1

#
#    NemesisSystem.AmbientGeneration.AnnounceZoneOnly
#        Description: Send the birth announcement only to players in the zone
#                     where it happened (0 = server-wide system message).
#        Default:     1
#

NemesisSystem.AmbientGeneration.AnnounceZoneOnly = 1

#
#    NemesisSystem.HunterRankScaling.Enable
#        Description: Seasoned hunters breed seasoned foes - nemeses born
#                     around a player start with a rank bonus from their
#                     Hunter's Covenant rank: 1-2 -> +0, 3-4 -> +1, 5 -> +2.
#                     Applies to kill-driven creation (victim's rank),
#                     dungeon spawns (best rank in the instance), ambient
#                     births (best rank in the zone) and task-target breeding.
#        Default:     1
#

NemesisSystem.HunterRankScaling.Enable = 1

########################################
# DUNGEON NEMESES
########################################

#
#    NemesisSystem.DungeonNemesis.Enable
#        Description: Creatures spawning in dungeon maps roll a chance to
#                     become a TEMPORARY nemesis (weighted random rank
#                     50/30/15/4/1, trash and elites only, bosses excluded).
#                     Per-instance, never persisted, dies with the instance.
#        Default:     1
#

NemesisSystem.DungeonNemesis.Enable = 1

#
#    NemesisSystem.DungeonNemesis.Chance
#        Description: Percent chance per eligible creature spawn.
#        Default:     3.0
#

NemesisSystem.DungeonNemesis.Chance = 3.0

#
#    NemesisSystem.DungeonNemesis.IncludeRaids
#        Description: Also roll in raid maps.
#        Default:     0
#

NemesisSystem.DungeonNemesis.IncludeRaids = 0

#
#    NemesisSystem.DungeonNemesis.RequireRealPlayers
#        Description: Only roll when the instance holds at least one real
#                     player (playerbot-only runs excluded).
#        Default:     1
#

NemesisSystem.DungeonNemesis.RequireRealPlayers = 1

########################################
# SPECIAL DAILY TASKS (особые поручения)
########################################

#
#    NemesisSpecialTask.Enable
#        Description: Innkeeper gossip "Особое поручение" — one completion per
#                     day, day's choice is final. Types: speed kill / opposite
#                     classic continent / dungeon nemesis.
#        Default:     1
#

NemesisSpecialTask.Enable = 1

#
#    NemesisSpecialTask.SpeedKillMinutes
#        Description: Time limit for the speed-kill task (2 hours).
#        Default:     120
#

NemesisSpecialTask.SpeedKillMinutes = 120

#
#    NemesisSpecialTask.TargetLevelBand
#        Description: World-task targets (speed/continent) must be within
#                     +- this many levels of the player - both for the named
#                     target selection and for kill credit.
#        Default:     3
#

NemesisSpecialTask.TargetLevelBand = 3

#
#    NemesisSpecialTask.FreeChoice
#        Description: TESTING — show all three tasks instead of the assigned
#                     daily roll. Leave 0 in production.
#        Default:     0
#

NemesisSpecialTask.FreeChoice = 0

#
#    NemesisSpecialTask.NoDailyLimit
#        Description: TESTING — ignore the one-completion-per-day cap.
#                     Leave 0 in production.
#        Default:     0
#

NemesisSpecialTask.NoDailyLimit = 0

#
#    NemesisSpecialTask.RewardItem
#        Description: Reward item (Монета авантюриста).
#        Default:     110150
#

NemesisSpecialTask.RewardItem = 110150

#
#    NemesisSpecialTask.Reward.Speed / .Continent / .Dungeon
#        Description: Coin count per completed task type (by difficulty).
#        Default:     1 / 2 / 3
#

NemesisSpecialTask.Reward.Speed = 1
NemesisSpecialTask.Reward.Continent = 1
NemesisSpecialTask.Reward.Dungeon = 1

#
#    NemesisSpecialTask.DungeonMinKills
#        Description: Minimum dungeon-nemesis kills for the clearing task
#                     (plus none left alive in the instance).
#        Default:     3
#

NemesisSpecialTask.DungeonMinKills = 3

###############################################################################
# BOUNTY BOARD SETTINGS
#
#    Per-player daily rotating list of nemesis contracts offered at innkeepers.
#    Accept one, kill the target within the duration, get bonus tokens.
#    Only one active contract per player at a time. No refund on 24h expiry,
#    but if an admin clears the target nemesis the player gets a consolation
#    mail.
###############################################################################

#
#    NemesisSystem.BountyBoard.Enable
#        Description: Master toggle for the bounty board gossip and logic.
#        Default:     1 - Enabled
#                     0 - Disabled
#

NemesisSystem.BountyBoard.Enable = 1

#
#    NemesisSystem.BountyBoard.SlotsPerDay
#        Description: Number of bounties offered to the player per daily
#                     rotation. If fewer eligible nemeses exist, the board
#                     will show fewer entries.
#        Default:     3
#

NemesisSystem.BountyBoard.SlotsPerDay = 3

#
#    NemesisSystem.BountyBoard.DurationHours
#        Description: How many hours an accepted bounty stays active before
#                     expiring. Uncompleted expiries give no refund.
#        Default:     24
#

NemesisSystem.BountyBoard.DurationHours = 24

#
#    NemesisSystem.BountyBoard.PoolRefreshHours
#        Description: How often the per-player per-zone bounty pool rotates.
#                     Within this window, talking to any innkeeper in the same
#                     zone shows the same bounties; completed bounties are
#                     hidden until the next rotation so they're not re-offered.
#                     Short enough that a cleared zone can refresh; long enough
#                     that players can't trivially re-roll by reopening gossip.
#        Default:     2
#

NemesisSystem.BountyBoard.PoolRefreshHours = 2

#
#    NemesisSystem.BountyBoard.LevelRangeDown
#        Description: Maximum levels below the player a nemesis may be to
#                     qualify. 0 = no limit (a high-level player may accept
#                     contracts on low-level nemeses). Independent of the
#                     regular nemesis-kill gray-level gating — the bounty
#                     contract reward is always granted on completion.
#        Default:     0 - No lower-level limit
#

NemesisSystem.BountyBoard.LevelRangeDown = 0

#
#    NemesisSystem.BountyBoard.LevelRangeUp
#        Description: Maximum levels above the player a nemesis may be to
#                     qualify. 0 = no limit.
#        Default:     0 - No upper-level limit
#

NemesisSystem.BountyBoard.LevelRangeUp = 0

#
#    NemesisSystem.BountyBoard.RewardTokens
#        Description: Base token reward for completing a bounty.
#        Default:     3
#

NemesisSystem.BountyBoard.RewardTokens = 3

#
#    NemesisSystem.BountyBoard.RewardTokensPerRank
#        Description: Additional tokens per nemesis rank. Total reward is
#                     RewardTokens + (RewardTokensPerRank * rank).
#        Default:     2
#

NemesisSystem.BountyBoard.RewardTokensPerRank = 2

#
#    NemesisSystem.BountyBoard.RewardGold
#        Description: Base gold reward (copper) for completing a bounty.
#        Default:     5000 (50 silver)
#

NemesisSystem.BountyBoard.RewardGold = 5000

#
#    NemesisSystem.BountyBoard.RewardGoldPerRank
#        Description: Additional gold (copper) per nemesis rank.
#        Default:     5000
#

NemesisSystem.BountyBoard.RewardGoldPerRank = 5000

#
#    NemesisSystem.BountyBoard.AnnounceAccept
#        Description: Broadcast a red server-wide message when a contract
#                     is accepted.
#        Default:     1 - Enabled
#

NemesisSystem.BountyBoard.AnnounceAccept = 1

#
#    NemesisSystem.BountyBoard.AnnounceCompletion
#        Description: Broadcast a red server-wide message when a contract
#                     is completed.
#        Default:     1 - Enabled
#

NemesisSystem.BountyBoard.AnnounceCompletion = 1

#
#    NemesisSystem.BountyBoard.RefundTokensOnAdminClear
#        Description: If the target nemesis is cleared by an admin/server
#                     command, mail the player this many consolation tokens
#                     and cancel the contract. Set to 0 to disable refunds.
#        Default:     1
#

NemesisSystem.BountyBoard.RefundTokensOnAdminClear = 1

###############################################################################
# Hunter's Covenant Reputation
#
# Server-only rank system awarded on eligible nemesis kills and bounty
# completions. 5 ranks: Послушник / Охотник / Следопыт / Ветеран Охоты /
# Легенда Охоты. Each rank grants a custom CharTitle (DBC IDs 200-204).
###############################################################################

#
#    NemesisRep.Enable
#        Description: Master switch for the reputation system.
#        Default:     1
#

NemesisRep.Enable = 1

#
#    NemesisRep.BasePerKill
#        Description: Flat reputation per eligible nemesis kill (gray-gated:
#                     gray-level kills grant 0). Combined with PerRankBonus.
#        Default:     50
#

NemesisRep.BasePerKill = 0

#
#    NemesisRep.PerRankBonus
#        Description: Additional rep per kill scaled by the nemesis rank
#                     (1-6). Total per kill = Base + PerRankBonus * rank.
#        Default:     10
#

NemesisRep.PerRankBonus = 1

#
#    NemesisRep.BountyCompletionBonus
#        Description: Flat bonus rep on completing a bounty contract.
#                     NOT gray-gated — the board only offers level-appropriate
#                     targets so exploit risk is nil.
#        Default:     200
#

NemesisRep.BountyCompletionBonus = 10

#
#    NemesisRep.BountyCompletionPerRank
#        Description: Per-rank addition to the bounty completion bonus.
#                     Total = BountyCompletionBonus + PerRank * bountyRank.
#        Default:     50
#

NemesisRep.BountyCompletionPerRank = 5

#
#    NemesisRep.SpecialTaskBonus
#        Description: Hunter's Covenant reputation granted on completing the
#                     innkeeper's daily special task.
#                     Total = Bonus + PerRank x hunter rank.
#        Default:     100 / 1
#

NemesisRep.SpecialTaskBonus = 100
NemesisRep.SpecialTaskPerRank = 1

#
#    NemesisRep.Threshold.Rank2..Rank5
#        Description: Rep points required to promote into each tier.
#                     Rank 1 (Послушник) starts at 0 and has no threshold.
#        Defaults:    500 / 2500 / 8000 / 20000
#

NemesisRep.Threshold.Rank2 = 500
NemesisRep.Threshold.Rank3 = 2500
NemesisRep.Threshold.Rank4 = 8000
NemesisRep.Threshold.Rank5 = 20000
